#!/usr/bin/env bash
set -euo pipefail

# ceremony-upgrade [--check|--fix] [--source <dir>] <target-tag> — move a
# consumer checkout from its current ceremony pin to ONE target tag, re-sync
# the doctrine mirror, and REFUSE where the move crosses a migration. Run
# from the root of a consumer checkout, like docs-sync (#561).
#
# It opens no PR, pushes nothing, and calls no GitHub write API: it edits a
# working tree and stops. Bootstrapping a repo that has no pin at all, and
# rewriting a consumer's configuration to satisfy a crossed migration, are
# both later children of #560 and are deliberately absent here.
#
# WHY THIS IS NOT `sed 's/0.7.4/0.7.7/g'`, which is the whole reason the
# command exists (#561). Two independent reasons, and either one alone is
# fatal:
#
#   1. A bare version string is not a pin. A consumer whose README mentions
#      the old version, or whose CHANGELOG.md carries a `## 0.7.6` heading,
#      is silently corrupted by a tree-wide substitution. So --fix rewrites
#      exactly the lines --check enumerated, by line number, and looks at no
#      other line in the file; --check leaves the tree byte-identical.
#   2. Several pin moves are MIGRATIONS, not substitutions. `docs/CONSUMERS.md`
#      records them as "available at `X` and later" notes, and crossing one
#      without the accompanying hand edit is destructive rather than
#      incomplete: crossing `0.4.1` without the two-caller split leaves the
#      trigger job red on every PR and issue event, and crossing `0.5.0`
#      backwards leaves a `panel[<login>]=` row on a ref whose parser refuses
#      it — "the whole label board goes down". So the refusal ships BEFORE any
#      migration does, and it is this command's deliverable.
#
# A REFUSAL LEAVES THE TREE BYTE-IDENTICAL, asserted by the suite over the
# whole tree and not over the files this tool would have touched. The
# alternative shape — rewrite the refs, then discover the migration, then
# refuse — leaves a consumer pinned forward with none of the hand edits that
# pin requires, which is strictly worse than never having run the command.
#
# Two mechanisms hold that up, and it takes both. Every check this command
# makes runs before any write — the ladder, the faults, the migration table.
# But this command does not write alone: it calls docs-sync, whose scaffold
# refusal fires inside its own fix loop, after it has written. So --fix is
# also a TRANSACTION over a declared write territory (see below): it
# snapshots that territory before the first byte, verifies the rewrite
# against the plan afterwards, and restores the snapshot on any failure from
# any depth — a refusal of its own, a non-zero docs-sync, a Ctrl-C. "Nothing
# was written" is a promise about the tree at exit, not about the order the
# checks happen to run in (codex-bot, PR #566 round 1).
#
# ALL THE REFS MOVE TOGETHER OR NONE DOES. A tree carrying two different
# ceremony refs has no single pin; docs-sync already refuses such a tree at
# the release caller, and this command refuses it across the whole of
# `.github/`. The pin shape it matches is deliberately the same anchored
# `uses:` shape docs-sync matches, comment lines excluded — where the two
# disagree about what a pin is, the mirror check and the bump disagree about
# what this repo is pinned to.
#
# THE MIRROR IS RE-SYNCED BY CALLING docs-sync --fix, NEVER BY COPYING. Two
# pins are two things to bump and two things to disagree (#19), and the same
# argument applies to two things that know how the mirror is written. The
# call comes AFTER the refs are rewritten, because the pin in
# `.github/workflows/release.yml` is the input docs-sync reads.
#
# A file of its own so test/ceremony-upgrade.test.sh can drive both modes
# against constructed consumer trees. --source <dir> substitutes a local
# ceremony checkout for the network, exactly as it does in docs-sync, and is
# passed through to it: offline tests, and previewing a ceremony PR against a
# consumer before anything is released.

SELF="$(basename "$0")"
HERE="$(cd "$(dirname "$0")" && pwd)"
DOCS_SYNC="$HERE/../actions/docs-sync/docs-sync.sh"
GITHUB_DIR=".github"
CHANGELOG_NAME="CHANGELOG.md"

# --- the migration table --------------------------------------------------
#
# One row per tag at which docs/CONSUMERS.md records an "available at `X` and
# later" note:
#
#   tag|CONSUMERS.md section|what the consumer must do by hand|applied step
#
# The interval is half-open, `(current, target]`, so a row fires when the move
# ARRIVES at that tag or passes over it, and never when the consumer is
# already standing on it.
#
# FIELD 4 IS THE ONLY THING THAT SAYS A TAG IS MECHANISED, and an empty field
# 4 is the whole of "it is not" (#597). A row with a step names the shell
# function that performs that tag's own edits; a row without one refuses
# exactly as every row did before any step existed, and the refusal's bytes
# are what the suite pins. The dispatch reads the FIRST crossed tag's field 4
# and nothing else: a mechanised tag deeper in the interval is unreachable
# until the tags below it are crossed, which is the ladder, one tag at a
# time. Fields 1-3 are unchanged by a row gaining a step — the hand procedure
# stays the source of truth for what the step performs, and stays what the
# reader is shown when the step cannot run against their tree.
#
# IT IS A LIST OF TAGS, NOT A LIST OF DESTRUCTIVE TAGS. Some of these notes
# announce a capability a consumer may ignore; others take a board down. The
# table does not sort them, because the sorting is a judgement made once, by
# hand, about a set that grows every release — and the one that gets misfiled
# is the one that costs a board. A refusal is cheap: it is one message and a
# `docs/CONSUMERS.md` section. Applying a migration nobody made is not.
#
# `0.1.0` is here for the same reason: it carries a note (the manifest), and
# leaving it out because it "obviously cannot fire" is the hand-curation this
# table exists to avoid. Being the first release, it can never fall inside a
# half-open interval opening at a released tag, so it is inert by
# construction rather than by anyone's judgement.
#
# ONE "and later" SENTENCE IN docs/CONSUMERS.md IS DELIBERATELY NOT A ROW,
# named here so that finding it and finding no row reads as a decision
# rather than as an omission:
#
#   * `0.7.7` (#501) — "At `0.7.7` and later the sweep says so as a comment on
#     the pull request". Not an availability note: it describes where an
#     existing notice is PRINTED, and asks nothing of a consumer tree. #561's
#     happy-path criterion moves a consumer 0.7.6 -> 0.7.7 and requires it to
#     succeed, which settles the reading independently.
#
# The guarded scaffold (#559) was the second such sentence and is no longer:
# it read "available at **unreleased** and later", with no tag to key a row
# on, and the 0.7.8 cut cleared that marker to its own tag (#221) exactly as
# this comment said it would. It is the `0.7.8` row below. Note what changed
# with it: while it was markered, `--fix` would have written the block itself
# on the way past, through the docs-sync call below; as a row it is a
# REFUSAL, and no crossing of it is automatic. That is the table's rule
# doing its job rather than an oversight — a tag whose note asks a consumer
# tree for a byte it does not have is a row, and whether this command could
# have supplied that byte is not the question the table asks.
#
# test/ceremony-upgrade.test.sh re-derives this tag set from docs/CONSUMERS.md
# and fails when a note names a tag no row carries — a ratchet against the
# note that ships without its row, not a proof that the prose scan is
# complete.
MIGRATIONS=(
  "0.1.0|Read the manifest, never a copy of it|docs/VENDORED.txt is the manifest actions/docs-sync mirrors; it ships with docs-sync itself and every later pin carries it.|"
  "0.2.0|Bootstrap a new repo|triage-actors= becomes MANDATORY in .github/labels.conf — its absence is a parse failure, not an ignored setting. Fragment mode, changelog-assembled, runner-isolated and the labeler's issues: trigger arrive with it.|"
  "0.3.0|Labels automation|.github/labeler.yml's accepted shape NARROWS to additive scope rows — any other key now fails the run loudly rather than being ignored.|"
  "0.4.1|Labels automation|THE TWO-CALLER SPLIT (#209), and it is the destructive one. Add .github/workflows/labels-sweep.yml; MOVE the hourly cron out of labels.yml into it — move, never copy, because a copied cron gives DOUBLE SWEEPS; and grant actions: write. Without the split the trigger job goes RED ON EVERY PR AND ISSUE EVENT and event-woken sweeps stop.|step_0_4_1_two_caller_split"
  "0.5.0|Labels automation|panel[<login>]= rows become legal in .github/labels.conf. A bracketed row on an earlier pin is a parse failure and the whole label board goes down, so never move backwards across this tag with one written.|"
  "0.6.0|Doctrine mirror|RELEASES.md joins the vendored set and .ceremony/ is short a file until the mirror is re-synced; refs-not-closing becomes available; and the manifest at a tag is guaranteed the complete set only from here.|"
  "0.7.0|The artifact hook|Native release-candidate cuts and deterministic rc re-arming arrive; earlier pins do not carry the rc release path.|"
  "0.7.8|The guarded scaffold — ceremony owns a block, you own the rest|.github/pull_request_template.md gains a ceremony-owned block, read from the pin's docs/SCAFFOLDED.txt, and docs-sync --check goes RED until it is there. Run docs-sync --fix from the repo root and commit that file alongside .ceremony/ in the SAME PR that moves the ref — split them and the default branch is red in between. Where the template already exists, --fix appends the block and leaves your own content alone.|"
)

die() {
  printf '%s\n' "$@" >&2
  exit 1
}

# --- arguments ------------------------------------------------------------
#
# Flags win over the env vars, and `check` is the default — docs-sync's
# interface exactly, because a consumer already knows that one.
mode="${MODE:-check}"
source_dir="${SOURCE:-}"
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check ;;
    --fix) mode=fix ;;
    --source)
      [ $# -ge 2 ] || die "$SELF: --source needs a directory"
      source_dir="$2"
      shift
      ;;
    -*) die "$SELF: unknown argument: $1 (usage: $SELF [--check|--fix] [--source <dir>] <target-tag>)" ;;
    *)
      [ -z "$target" ] || die \
        "$SELF: two target tags given ('$target' and '$1') — a consumer has" \
        "  one pin and this command moves it to one tag."
      target="$1"
      ;;
  esac
  shift
done
case "$mode" in
  check | fix) ;;
  *) die "$SELF: unknown mode: '$mode' (check or fix)" ;;
esac
[ -n "$target" ] || die \
  "$SELF: no target tag (usage: $SELF [--check|--fix] [--source <dir>] <target-tag>)"

# The rewrite puts this string into a workflow file, so it is bounded to what
# a git ref can be made of before it is written anywhere. This is not a
# release-tag test — that one needs the ladder, below, and has its own
# message — it is the character bound that keeps a shell or awk metacharacter
# out of the substitution.
case "$target" in
  *[!A-Za-z0-9._-]* | "" | -*)
    die "$SELF: refusing target '$target' — a ceremony ref is made of" \
      "  letters, digits, dot, underscore and hyphen, and does not start" \
      "  with a hyphen. Nothing was read and nothing was written."
    ;;
esac

[ -f "$DOCS_SYNC" ] || die \
  "$SELF: cannot find actions/docs-sync/docs-sync.sh at $DOCS_SYNC —" \
  "  this command re-syncs the mirror by CALLING docs-sync, never by copying" \
  "  what it writes, so it must be run from a complete ceremony checkout."

# --- the consumer's refs --------------------------------------------------
#
# THE PIN SHAPE IS docs-sync's, on purpose. A real `uses:` key only: a
# leading '#' makes it a comment and it does not count, because ceremony's own
# release.yml carries the pin shape inside a header essay and any consumer
# that pasted a documentation snippet would otherwise appear to carry a
# second pin. A quoted ref is invisible to this pattern exactly as it is
# invisible to docs-sync's — where the two disagree about what a pin is, the
# mirror check and the bump disagree about what this tree is pinned to, which
# is the drift both tools exist to make unrepresentable.
PIN_RE='^[[:space:]]*(-[[:space:]]*)?uses:[[:space:]]*heavy-duty/ceremony(/[^@[:space:]]*)?@[^[:space:]]'

[ -d "$GITHUB_DIR" ] || die \
  "$SELF: no $GITHUB_DIR/ here — run this from the root of a consumer" \
  "  checkout, the same place docs-sync runs from."

# find, not a glob: workflow callers live at .github/workflows/ but composite
# actions and reusable fragments nest deeper, and every ceremony ref in the
# tree moves together. Symlinks are enumerated (-o -type l) so that one is
# REFUSED below rather than skipped — a link silently missed by `-type f`
# leaves a ref behind and turns "all or none" into a lie.
#
# The scan is INSIDE enumerate_pins rather than beside it, so the one reader
# reads the tree as it stands each time it runs. An applied step creates a
# caller file carrying a pin of its own, and a file list captured once before
# any write is a list that cannot see it — the post-write re-enumeration then
# reports one ref fewer than the plan announced and rolls a correct run back
# (#597).
yaml_files=()

# enumerate_pins — read every ceremony pin in the tree into pin_files,
# pin_refs, pin_lines (1-based line numbers) and pin_file_list (the distinct
# files, in order).
#
# THE ONE READER. The plan, every refusal, the rewrite and the post-write
# verification all go through this function, so there is no second opinion
# anywhere in the command about what a pin is. That is not tidiness: --fix
# used to match by its own awk pattern, which was a SUPERSET of PIN_RE — it
# lacked the '/' that anchors the repository name — so a `heavy-duty/ceremony`
# SIBLING repo's `uses:` line was invisible to --check and rewritten by --fix
# anyway, and a plan that named one ref wrote three at exit 0 (claude-bot,
# round 1). The header essay above argues at length that a disagreement about
# what a pin is must be unrepresentable between this command and docs-sync;
# it was representable INSIDE this one. The repair is not a better second
# pattern, it is no second pattern: --fix rewrites the LINE NUMBERS --check
# enumerated, and nothing else in the file is even looked at.
pin_files=()
pin_refs=()
pin_lines=()
pin_file_list=()
enumerate_pins() {
  local f line lineno ref had
  mapfile -t yaml_files < <(
    find "$GITHUB_DIR" \( -type f -o -type l \) \
      \( -name '*.yml' -o -name '*.yaml' \) | LC_ALL=C sort
  )
  pin_files=()
  pin_refs=()
  pin_lines=()
  pin_file_list=()
  for f in "${yaml_files[@]}"; do
    if [ -L "$f" ]; then
      grep -qE "$PIN_RE" "$f" 2>/dev/null || continue
      die "$SELF: $f is a symlink and carries a ceremony pin — rewriting it" \
        "  would write through the link, anywhere this process can reach." \
        "  Refusing both modes: replace the symlink with a regular file."
    fi
    had=0
    while IFS= read -r line; do
      lineno="${line%%:*}"
      line="${line#*:}"
      # The comment is stripped BEFORE the ref is taken, so a trailing note
      # containing '@' cannot capture the greedy match; the path itself cannot
      # contain '@' because the pattern above excludes it.
      ref="$(printf '%s\n' "$line" | sed -E 's/[[:space:]]*#.*$//; s/^.*@//; s/[[:space:]]*$//')"
      [ -n "$ref" ] || die \
        "$SELF: a ceremony pin line in $f carries an empty ref after '@'."
      pin_files+=("$f")
      pin_refs+=("$ref")
      pin_lines+=("$lineno")
      had=1
    done < <(grep -nE "$PIN_RE" "$f" || true)
    if [ "$had" -eq 1 ]; then
      pin_file_list+=("$f")
    fi
  done
}

# pin_lines_in FILE — the pin line numbers in FILE, comma-joined, in the order
# enumerate_pins found them. This is what the rewrite is aimed at.
pin_lines_in() {
  local want="$1" i out=""
  for i in "${!pin_files[@]}"; do
    if [ "${pin_files[$i]}" = "$want" ]; then
      out="${out:+$out,}${pin_lines[$i]}"
    fi
  done
  printf '%s\n' "$out"
}

enumerate_pins

# ref_report — every pin, one per line, for the plan and for the refusals.
# A refusal SAYS WHAT IT WOULD HAVE DONE, so the reader knows the refusal is
# about the migrations and not about the refs (#561 G5).
ref_report() {
  local i
  for i in "${!pin_files[@]}"; do
    printf '    %s  @%s\n' "${pin_files[$i]}" "${pin_refs[$i]}"
  done
}

# --- fault 1: no pin ------------------------------------------------------
if [ "${#pin_files[@]}" -eq 0 ]; then
  die "$SELF: FAULT — no ceremony pin in $GITHUB_DIR/." \
    "" \
    "  This tree carries no 'uses: heavy-duty/ceremony/...@<ref>' line, so" \
    "  there is no current pin to move FROM and nothing to place on the" \
    "  release ladder. That is BOOTSTRAP — writing a consumer's first caller" \
    "  set — and it is a later child of #560, not a thing this command does" \
    "  and not a sign that this command is broken." \
    "" \
    "  Until it ships, docs/CONSUMERS.md's 'Bootstrap a new repo' section is" \
    "  the hand procedure. Nothing was written."
fi

# --- fault 2: the refs are not all at one ref -----------------------------
current="${pin_refs[0]}"
differing=()
for i in "${!pin_refs[@]}"; do
  [ "${pin_refs[$i]}" = "$current" ] || differing+=("${pin_files[$i]}  @${pin_refs[$i]}")
done
if [ "${#differing[@]}" -gt 0 ]; then
  {
    echo "$SELF: FAULT — this tree's ceremony refs are not all at one ref, so it has no single pin to move."
    echo
    echo "  Every ceremony ref found (${#pin_files[@]} in ${#pin_file_list[@]} file(s) under $GITHUB_DIR/):"
    ref_report
    echo
    echo "  '${pin_files[0]}' is at @$current; these differ from it:"
    printf '    %s\n' "${differing[@]}"
    echo
    echo "  All the refs move together or none does: a tree carrying two"
    echo "  ceremony refs has no single pin, doctrine and machinery can be at"
    echo "  two different versions of the rules, and docs-sync already refuses"
    echo "  such a tree at the release caller. Put them on one ref by hand,"
    echo "  then re-run. Nothing was written."
  } >&2
  exit 1
fi

# --- the release ladder ---------------------------------------------------
#
# WHAT ORDERS THE TAGS IS THE CHANGELOG, NOT A COMPARATOR. The ladder is the
# release headings of ceremony's own CHANGELOG.md at the target ref, in file
# order — every version that had shipped when that tag was cut. Two
# consequences, and both are why it is done this way:
#
#   * "is a released tag" needs no definition of its own. A released version
#     has a section; a branch, a SHA and a tag that was never cut do not.
#   * the half-open interval `(current, target]` is a SLICE of that list,
#     found by position. No version comparison happens anywhere in this
#     command, so there is no second ordering in this repository to disagree
#     with an existing one in some edge case (#561 G7). Nothing here needs to
#     know that 0.10.0 follows 0.9.0: the changelog already said so.
#
# The heading shape is changelog-monotonic's — '## ' then a version-shaped
# field 2 — so the two cannot disagree about what a release section is.
scratch="$(mktemp -d)"

# --- the write territory, and the transaction over it ----------------------
#
# WHAT --fix IS ALLOWED TO CHANGE, declared in one place and snapshotted
# before the first byte is written:
#
#   * $GITHUB_DIR/  — the pins this command rewrites, and (today) the one
#                     guarded scaffold docs-sync writes
#   * $MIRROR_DIR/  — the doctrine mirror docs-sync writes
#   * the root's regular files — the AGENTS.md stub docs-sync scaffolds
#
# WHY A TRANSACTION AND NOT A PREFLIGHT. "Every check runs before any write"
# was true of this command and false of the pair: docs-sync's own scaffold
# refusal (`markers are duplicated|unbalanced`) fires INSIDE its fix loop,
# after the mirror and the AGENTS.md stub are written — so a consumer whose
# pull_request_template.md had a broken marker came out of `--fix` pinned
# forward with a half-written mirror and none of the hand edits a pin implies.
# That is the half-upgraded consumer this command exists to make
# unrepresentable (codex-bot, round 1).
#
# Preflighting docs-sync's refusal list from here would mean a SECOND READER
# of docs/SCAFFOLDED.txt and docs/VENDORED.txt, which is the same
# two-readers-disagree bug the round's other blocker was — and a reader of a
# format this command has no other reason to know. So the territory is
# declared, not derived, and the day the declaration goes stale is caught in
# ceremony's own CI rather than in a consumer: test/ceremony-upgrade.test.sh
# reads both manifests and fails when a path they name falls outside these
# roots. A ratchet, exactly like the availability-tag one — it cannot prove
# the declaration complete, it closes the direction that is cheap to close.
#
# The rollback runs from the EXIT trap, so it covers every way out: a die, a
# non-zero docs-sync, an unexpected failure under `set -e`, and (via the INT
# and TERM traps below, which fall through to EXIT) a Ctrl-C mid-write.
MIRROR_DIR=".ceremony"
SNAP="$scratch/snapshot"
ROOT_SNAP="$SNAP/__root__"
snapshot_taken=0
committed=0

take_snapshot() {
  local root f
  mkdir -p "$SNAP" "$ROOT_SNAP"
  for root in "$GITHUB_DIR" "$MIRROR_DIR"; do
    if [ -e "$root" ]; then
      cp -pPR "$root" "$SNAP/$root"
    fi
  done
  while IFS= read -r -d '' f; do
    cp -pPR "$f" "$ROOT_SNAP/${f##*/}"
  done < <(find . -maxdepth 1 -type f -print0)
  snapshot_taken=1
}

# Exact, not best-effort: a directory root is replaced wholesale from the
# snapshot (or removed, if it did not exist), and at the root only the regular
# files that appeared are deleted and only the ones that differ are written
# back — so a file this run never touched keeps its inode.
restore_snapshot() {
  local root f base
  for root in "$GITHUB_DIR" "$MIRROR_DIR"; do
    if [ -e "$SNAP/$root" ]; then
      rm -rf "$root" || return 1
      cp -pPR "$SNAP/$root" "$root" || return 1
    else
      rm -rf "$root" || return 1
    fi
  done
  while IFS= read -r -d '' f; do
    base="${f##*/}"
    if [ ! -e "$ROOT_SNAP/$base" ]; then
      rm -f "$f" || return 1
    fi
  done < <(find . -maxdepth 1 -type f -print0)
  while IFS= read -r -d '' f; do
    base="${f##*/}"
    if [ ! -e "./$base" ] || ! cmp -s "$f" "./$base"; then
      cp -pPR "$f" "./$base" || return 1
    fi
  done < <(find "$ROOT_SNAP" -maxdepth 1 -type f -print0)
}

cleanup() {
  # No `exit` on the success path: an EXIT trap that returns normally leaves
  # the shell's own status alone, so a refusal keeps its non-zero.
  trap - EXIT
  if [ "$snapshot_taken" -eq 1 ] && [ "$committed" -eq 0 ]; then
    if restore_snapshot; then
      printf '%s\n' \
        "$SELF: rolled back — the tree is byte-identical to what it was before this run." >&2
    else
      printf '%s\n' \
        "$SELF: ROLLBACK FAILED after the run above failed. The snapshot of" \
        "  $GITHUB_DIR/, $MIRROR_DIR/ and this tree's root files, taken before" \
        "  the first write, is kept at:" \
        "    $SNAP" \
        "  It is NOT deleted, so the tree can be restored by hand. Nothing else" \
        "  in this command will touch the tree." >&2
      exit 1
    fi
  fi
  rm -rf "$scratch"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -n "$source_dir" ]; then
  [ -d "$source_dir" ] || die "$SELF: --source: no such directory: $source_dir"
  changelog_file="$source_dir/$CHANGELOG_NAME"
  ladder_origin="$source_dir (--source override, standing in for heavy-duty/ceremony@$target)"
  [ -f "$changelog_file" ] || die \
    "$SELF: --source: no $CHANGELOG_NAME in $source_dir — the release ladder" \
    "  is read from ceremony's own changelog, so a source tree without one" \
    "  cannot say which tags exist or what order they came in."
else
  # ONE FILE, NOT THE TREE. docs-sync fetches the whole archive because it
  # mirrors it; this command needs the ladder and nothing else, and it hands
  # the tree fetch to docs-sync (which does it once, afterwards, with its own
  # retry policy and its own fault classes). Two steps, never a pipe (#393):
  # nothing is being extracted here, but the status is still captured rather
  # than inferred, %{http_code} being 000 when no HTTP response arrived.
  changelog_file="$scratch/CHANGELOG.md"
  ladder_origin="heavy-duty/ceremony@$target"
  url="https://raw.githubusercontent.com/heavy-duty/ceremony/$target/$CHANGELOG_NAME"
  fetch_rc=0
  http_code="$(curl -fsSL --retry 3 --retry-delay 5 --retry-connrefused \
    -o "$changelog_file" -w '%{http_code}' "$url")" || fetch_rc=$?
  if [ "$fetch_rc" -ne 0 ]; then
    case "$http_code" in
      404)
        die "$SELF: FAULT — the target tag '$target' does not exist upstream." \
          "" \
          "  HTTP 404 for $url: heavy-duty/ceremony has no ref by that name," \
          "  so there is nothing to move this consumer to. Check the tag" \
          "  against the release list, or pass --source <dir> to preview an" \
          "  unreleased ceremony tree. Nothing was written."
        ;;
      5??)
        die "$SELF: GitHub returned HTTP $http_code for $url after 4 attempts." \
          "  The target tag is not in doubt — it was never read. This is" \
          "  transient: re-run. Nothing was written."
        ;;
      *)
        die "$SELF: could not fetch $url — curl exit $fetch_rc, HTTP status" \
          "  $http_code. A network failure reaching GitHub, not a statement" \
          "  about the tag. Nothing was written."
        ;;
    esac
  fi
fi

# Field 2 of a '## ' line, version-shaped, in FILE order. The whole field is
# the member, so 0.7.0 and 0.7.0-rc1 are distinct and neither stands in for
# the other. 'Unreleased' fails the shape and is excluded by construction.
mapfile -t ladder_desc < <(
  awk '/^## / && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+/ { print $2 }' "$changelog_file"
)
[ "${#ladder_desc[@]}" -gt 0 ] || die \
  "$SELF: no release headings in $CHANGELOG_NAME at $ladder_origin — the" \
  "  release ladder is empty, so no move can be graded. Nothing was written."

# Oldest first: the changelog is newest first, and every index comparison
# below reads more plainly forwards.
ladder=()
for ((i = ${#ladder_desc[@]} - 1; i >= 0; i--)); do
  ladder+=("${ladder_desc[$i]}")
done

ladder_index() {
  local want="$1" i
  for i in "${!ladder[@]}"; do
    if [ "${ladder[$i]}" = "$want" ]; then
      printf '%s\n' "$i"
      return 0
    fi
  done
  return 1
}

# --- fault 3: the target tag is not a released tag ------------------------
target_i=""
target_i="$(ladder_index "$target")" || die \
  "$SELF: FAULT — the target tag '$target' does not exist upstream." \
  "" \
  "  It has no release section in $CHANGELOG_NAME at $ladder_origin, so it" \
  "  was never cut as a release. A branch or a commit SHA is not a target" \
  "  either: the ladder is what says which migrations a move crosses, and a" \
  "  ref that is not on it cannot be placed. Nothing was written."

# --- fault 4: the current ref is not a released tag -----------------------
current_i=""
current_i="$(ladder_index "$current")" || die \
  "$SELF: FAULT — the current pin '$current' is not a released tag." \
  "" \
  "  Found in ${pin_files[0]} (and ${#pin_files[@]} ceremony ref(s) in all)." \
  "  It has no release section in $CHANGELOG_NAME at $ladder_origin, so it is" \
  "  a branch, a commit SHA, or a tag that was never cut — and a ref that is" \
  "  not on the ladder cannot be placed on it. Which migrations the move" \
  "  would cross is therefore unknowable, and this command refuses to guess" \
  "  rather than move a pin it cannot grade." \
  "" \
  "  Pin this tree to a released tag by hand first, then re-run. Nothing was" \
  "  written."

# --- already there --------------------------------------------------------
#
# Not a fault. --fix still calls docs-sync, because the mirror can be stale at
# a correct pin — a bump PR that moved the refs and never re-synced is exactly
# that tree — and because this is what makes a second --fix run report nothing
# to do rather than skip the check that says so.
if [ "$current_i" -eq "$target_i" ]; then
  echo "$SELF: already at $target — ${#pin_files[@]} ceremony ref(s), all at @$target:"
  ref_report
  if [ "$mode" = "check" ]; then
    echo "$SELF: nothing to do."
    exit 0
  fi
  echo "$SELF: re-syncing the doctrine mirror (docs-sync --fix)."
  # Snapshotted like every other --fix path: docs-sync can refuse mid-write on
  # a broken scaffold marker here too, and "a refusal leaves the tree
  # byte-identical" has to hold on the branch where no pin moves as well.
  take_snapshot
  if [ -n "$source_dir" ]; then
    bash "$DOCS_SYNC" --fix --source "$source_dir"
  else
    bash "$DOCS_SYNC" --fix
  fi
  committed=1
  echo "$SELF: nothing to do — the pin was already at $target."
  exit 0
fi

# --- fault 5: the move is backwards ---------------------------------------
#
# BEYOND #561's FOUR FAULTS, AND DISCLOSED AS SUCH. G5 refuses on the contents
# of `(current, target]`, and that interval is EMPTY for every backwards move
# — so the spec as written applies a downgrade silently. A downgrade is the
# strictly more dangerous direction: crossing 0.5.0 downwards leaves a
# `panel[<login>]=` row on a ref whose parser refuses it, and 0.4.1 downwards
# leaves a labels-sweep.yml caller pinned to a ref that has no such reusable.
# Neither has a hand procedure in docs/CONSUMERS.md, whose notes are all
# written forwards. Refusing is the only answer this command can give that is
# not a guess.
if [ "$current_i" -gt "$target_i" ]; then
  {
    echo "$SELF: FAULT — that is a DOWNGRADE: $current is newer than $target."
    echo
    echo "  Every ceremony ref found (${#pin_files[@]}), all at @$current:"
    ref_report
    echo
    echo "  docs/CONSUMERS.md's migration notes are written forwards — they say"
    echo "  what a tag ADDED, never how to undo it — so a backwards move has no"
    echo "  hand procedure to name and this command will not invent one. The"
    echo "  dangerous cases are real: below 0.5.0 a panel[<login>]= row is a"
    echo "  parse failure that takes the whole label board down, and below"
    echo "  0.4.1 a labels-sweep.yml caller points at a reusable that does not"
    echo "  exist at that ref."
    echo
    echo "  If the downgrade is genuinely what you want, move the refs by hand"
    echo "  and undo the crossed migrations deliberately. Nothing was written."
  } >&2
  exit 1
fi

# --- fault 6: the interval crosses a migration ----------------------------
#
# The half-open interval (current, target]: every ladder position strictly
# after the current one and up to and including the target. Positional, so a
# tag that is in the table but not on this ladder — a version that had not
# shipped when the target was cut — simply is not in the slice.
crossed=()
first_crossed_i=-1
first_crossed_step=""
for ((i = current_i + 1; i <= target_i; i++)); do
  for row in "${MIGRATIONS[@]}"; do
    if [ "${row%%|*}" = "${ladder[$i]}" ]; then
      crossed+=("$row")
      if [ "$first_crossed_i" -lt 0 ]; then
        first_crossed_i="$i"
        # Field 4 of the FIRST crossed row, and the only read of it: empty
        # means the tag is not mechanised and the refusal below is the whole
        # of this command's answer.
        IFS='|' read -r _ _ _ first_crossed_step <<<"$row"
      fi
    fi
  done
done

# refuse_crossing — the crossed-migration refusal, and the ONE place its bytes
# are written. Two callers reach it and they must not drift apart: a first
# crossed tag with no applied step (every row before #597, and every row but
# one after it), and a mechanised tag whose step cannot anchor itself in THIS
# tree. The second adds a section saying what could not be anchored and
# nothing else, because everything the first says — the crossed set in ladder
# order, each tag's section, the hand procedure, the shorter move, the
# unchanged tree — is exactly as true when the step is the thing that failed.
#
# `step_blocked` is that section: empty for the unmechanised case, which is
# what keeps those bytes identical to the ones the suite pins.
step_blocked=()
refuse_crossing() {
  local row tag rest section what step_i
  step_i=$((first_crossed_i - 1))
  printf -v runnable_self '%q' "$0"
  if [ -n "$source_dir" ]; then
    printf -v quoted_source_dir '%q' "$source_dir"
    runnable_self+=" --source $quoted_source_dir"
  fi
  {
    echo "$SELF: FAULT — moving $current -> $target crosses ${#crossed[@]} migration(s), so this command refuses to move the pin."
    echo
    echo "  A migration is not a substitution. Each tag below changed what a"
    echo "  consumer tree must CONTAIN, and rewriting the ref without the"
    echo "  accompanying hand edit does not leave you half-upgraded — it leaves"
    echo "  a tree that fails loudly, or a board that stops working."
    echo
    echo "  FIRST CROSSED TAG: $first_crossed"
    echo
    for row in "${crossed[@]}"; do
      tag="${row%%|*}"
      rest="${row#*|}"
      section="${rest%%|*}"
      rest="${rest#*|}"
      what="${rest%%|*}"
      echo "  $tag — docs/CONSUMERS.md § \"$section\""
      # fold, not a fixed wrap in the table: the table's cells stay one
      # editable line each and the terminal decides where they break.
      printf '%s\n' "$what" | fold -s -w 68 | sed 's/^/      /'
      echo
    done
    echo "  WHAT THIS COMMAND WOULD HAVE DONE, so that the refusal is legible as"
    echo "  being about the migrations above and not about the refs:"
    echo
    echo "    rewrite ${#pin_files[@]} ceremony ref(s) from @$current to @$target:"
    ref_report
    echo "    then re-sync the doctrine mirror (docs-sync --fix)."
    echo
    if [ "${#step_blocked[@]}" -gt 0 ]; then
      printf '%s\n' "${step_blocked[@]}"
      echo
    fi
    # The pin, not evidence of a hand edit in the tree, defines the interval.
    # So the only truthful crossing moves the edits and refs together, while
    # the only automatic alternative must end below the first crossed tag
    # and be proven by running the emitted target through this command (#588).
    echo "  THE CROSSING IS HAND-ONLY"
    echo "  The crossed set is read from the pin on the ladder, never from the tree."
    echo "  To cross $first_crossed by hand, perform its named edits and move every"
    echo "  ceremony ref to @$first_crossed in the same commit. Edits alone do not"
    echo "  move the pin and cannot change this refusal. After that commit, this"
    echo "  command resumes from the new pin."
    echo
    if [ "$step_i" -gt "$current_i" ]; then
      echo "  SHORTER MOVE: $runnable_self ${ladder[$step_i]}"
    else
      echo "  NO SHORTER MOVE: the first crossed tag $first_crossed is the next tag on the ladder after $current."
    fi
    echo
    # On its own line, unwrapped: this is the sentence a reader greps for
    # after a refusal, and a phrase broken across two lines is a phrase that
    # cannot be found by the search anyone would actually run.
    echo "  THE TREE IS UNCHANGED: nothing was written."
  } >&2
  exit 1
}

# --- the applied step -----------------------------------------------------
#
# AN APPLIED STEP NEVER MOVES PAST THE FIRST CROSSED TAG. Where that tag is
# mechanised, this command performs `current -> first_crossed` — the refs,
# that tag's own edits, and the mirror — and stops, reporting the pin it left
# the tree at and what is left between there and the tag that was asked for.
# It does not chain steps in one run: that is the ladder, one tag at a time,
# and the run that chains is the half-upgraded consumer this whole command
# exists to make unrepresentable. The next run continues from the new pin,
# which is exactly what the hand procedure has always told a reader to do.
#
# A STEP IS A PLANNER, NOT A WRITER. It reads the tree, refuses anything it
# cannot anchor unambiguously, and fills the four arrays below; the generic
# apply and verify passes at the bottom of this file do every write. Two
# reasons, and the second is the one that matters: a step that wrote for
# itself would be a second writer of a consumer tree, outside the declared
# territory's transaction and outside the plan --check prints — and the plan
# and the writes disagreeing at exit 0 is the defect class this command has
# already shipped once.
#
#   step_plan[]      lines printed under THE PLAN, by --check and by --fix
#   step_new_file    a path this step creates (its bytes in $step_new_body)
#   step_edit_file   a path this step edits in place
#   step_edit_ops[]  those edits, one per line, keyed by the line number in
#                    the file AS IT STANDS NOW: "<lineno>\t<kind>\t<text>",
#                    kind being del (drop it), sub (replace with text), ins
#                    (keep it, then emit text after it) or mask (a pin line,
#                    rewritten by the ref pass and compared by nobody here)
step_plan=()
step_new_file=""
step_new_body=""
step_edit_file=""
step_edit_ops=()
step_next_crossed=""

# step_refuse — the step cannot anchor itself in this tree, so the crossing is
# hand-only for this tree and the ordinary refusal is the right answer. The
# lines given become the section that says which shape stopped it.
step_refuse() {
  step_blocked=("$@")
  refuse_crossing
}

GUIDE_NAME="docs/CONSUMERS.md"

# load_guide TAG — put docs/CONSUMERS.md AS IT STANDS AT TAG in $guide_file.
#
# THE GUIDE AT THE CROSSED TAG IS THE ONE SOURCE OF THE CALLER STUB, and this
# is the only read of it. No copy of that stub ships in this file, in a
# manifest, or in a fixture: two copies of a published block are two things to
# bump and two things to disagree, and the block a consumer is told to write
# by hand and the block this step writes for them cannot be allowed to be
# different bytes. The tag matters as much as the file — the stub's bytes move
# across releases, and the crossing is about the tag being crossed, never
# about the target the operator happened to ask for or about main.
#
# The network path fetches ONE FILE, not the tree, in the same two-step
# status-captured shape as the ladder read above (#393). --source substitutes
# a local ceremony checkout for it, as everywhere else in this command.
guide_file=""
load_guide() {
  local tag="$1" url fetch_rc http_code
  if [ -n "$source_dir" ]; then
    guide_file="$source_dir/$GUIDE_NAME"
    [ -f "$guide_file" ] || die \
      "$SELF: --source: no $GUIDE_NAME in $source_dir." \
      "" \
      "  The applied step for $tag writes the caller stub that guide" \
      "  publishes, and there is no second copy of it anywhere to fall back" \
      "  to. Nothing was written."
    return 0
  fi
  guide_file="$scratch/CONSUMERS.md"
  url="https://raw.githubusercontent.com/heavy-duty/ceremony/$tag/$GUIDE_NAME"
  fetch_rc=0
  http_code="$(curl -fsSL --retry 3 --retry-delay 5 --retry-connrefused \
    -o "$guide_file" -w '%{http_code}' "$url")" || fetch_rc=$?
  [ "$fetch_rc" -eq 0 ] || die \
    "$SELF: could not read $GUIDE_NAME at the crossed tag $tag — curl exit" \
    "  $fetch_rc, HTTP status $http_code for:" \
    "    $url" \
    "" \
    "  The applied step writes the caller stub that guide publishes at the" \
    "  tag being crossed, and there is no second copy of it to fall back to." \
    "  Nothing was written."
}

# fenced_block FILE ANCHOR — the first ```yaml fence after the line matching
# ANCHOR, exactly as the suite extracts the release caller from the same
# guide. A block that is not there is not defaulted: every caller of this
# fails loudly on empty output.
fenced_block() {
  awk -v anchor="$2" '
    $0 ~ anchor { armed = 1; next }
    armed && /^```yaml$/ { inblock = 1; next }
    inblock && /^```$/ { exit }
    inblock { print }
  ' "$1"
}

# yaml_uncomment — stdin with a trailing YAML comment removed, quote-aware, so
# a `#` inside a quoted scalar is not mistaken for one. A `#` only opens a
# comment at the start of the line or after whitespace, which is YAML's own
# rule and the difference between reading `cron: "0 * * * *"` and truncating
# it.
yaml_uncomment() {
  awk '
    BEGIN { sq = sprintf("%c", 39); dq = sprintf("%c", 34) }
    {
      out = ""; q = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (q != "") { if (c == q) q = "" }
        else if (c == sq || c == dq) { q = c }
        else if (c == "#" && (i == 1 || substr($0, i - 1, 1) ~ /[ \t]/)) { break }
        out = out c
      }
      sub(/[ \t]+$/, "", out)
      print out
    }
  '
}

# block_body FILE START — every line of the block opened by the top-level key
# at line START, as "<lineno>\t<line>". The block ends at the next line that
# begins in column 0 with something that is not a space, which is what "top
# level" means in a workflow file. A comment at column 0 ends it too: it is
# not indented into the block, so nothing here may claim it is.
block_body() {
  awk -v start="$2" '
    NR <= start { next }
    /^[^ \t]/ { exit }
    { printf "%s\t%s\n", NR, $0 }
  ' "$1"
}

# top_level_key FILE KEY — "<lineno>\t<rest of the line after the colon>" for
# the first `KEY:` at column 0, or nothing. The rest is uncommented, so a bare
# block key comes back empty and a flow value does not.
top_level_key() {
  awk -v key="$2" '
    $0 ~ "^" key ":" { printf "%s\t%s\n", NR, substr($0, length(key) + 2); exit }
  ' "$1" | {
    IFS=$'\t' read -r n rest || return 0
    [ -n "${n:-}" ] || return 0
    printf '%s\t%s\n' "$n" \
      "$(printf '%s\n' "$rest" | yaml_uncomment | sed 's/^[[:space:]]*//')"
  }
}

# --- 0.4.1: the two-caller split ------------------------------------------
#
# THE LADDER'S FIRST TAG, and the destructive one, so it is the tag the
# mechanism is proven against (#597). The guide's own refusal table records
# that a crossing was hand-only for every tag before this; it is hand-only for
# every other tag still.
#
# The guide states this migration as ONE atomic PR with exactly four edits:
# bump every ceremony ref; ADD .github/workflows/labels-sweep.yml, the stub
# verbatim with its bootstrap input; MOVE — never copy — the hourly cron off
# the labels caller; and grant actions: write there. This step performs all
# four, and the ref bump is the ordinary one above.
#
# EVERY READ HERE IS ANCHORED, AND ANYTHING IT CANNOT ANCHOR IS A REFUSAL. The
# two real consumers measured for this step share not one line with the
# published stub — different cadence, different trigger lists, different
# permission blocks, repo-specific comments on the very lines being deleted —
# so a step that matched the stub's bytes, or that reached for `sed`, would
# fail on both of them. What it can anchor is the shape: a top-level `on:`
# block mapping carrying exactly one single-line `schedule:` and at most one
# bare `workflow_dispatch:`, and a top-level `permissions:` block mapping.
# Anything else — two schedules, a dispatch carrying inputs, a schedule
# written as a block sequence with no bound the step can find, a flow mapping
# where a block is expected — is a tree this step declines to guess at, and
# declining costs the reader one hand migration they already had a procedure
# for. Guessing costs them the board.
step_0_4_1_two_caller_split() {
  local sweep stub_body i line existing sched_repl
  local caller="" caller_pin_line="" job_line=""
  local on_line on_rest perm_line perm_rest
  local sched_line="" sched_value="" sched_count=0
  local disp_line="" disp_count=0
  local actions_line="" actions_value="" actions_count=0
  local perm_last_key="" perm_indent="" on_indent=""
  local caller_name="" caller_name_raw="" runner="" with_line=""
  local lineno text indent key val
  local stub_sched_lines with_pairs="" sweep_name

  sweep="$GITHUB_DIR/workflows/labels-sweep.yml"

  # The sweep caller must not already exist. This step CREATES it; merging
  # into a file someone else wrote is a different act with a different set of
  # ways to be wrong, and it is not this one.
  #
  # BOTH SPELLINGS, because GitHub reads both and this file's own enumeration
  # already knows it: a hand-written `labels-sweep.yaml` that only a `.yml`
  # test looks past gets a second sweep caller written beside it, and two
  # sweep callers on one board is the DOUBLE SWEEPS this tag is first on the
  # ladder to prevent — reached at exit 0, by the operator who did half the
  # migration by hand and then reached for the command (claude-bot §3).
  for existing in "$sweep" "${sweep%.yml}.yaml"; do
    [ -e "$existing" ] || continue
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $existing already exists. This step creates the sweep" \
      "  caller; it never merges into a file that is already there."
  done

  # The labels caller is the file carrying the ceremony labels.yml pin, found
  # through the enumerated pin lines — the one reader, again, so this step
  # cannot disagree with the plan about which file it is looking at.
  for i in "${!pin_files[@]}"; do
    line="$(sed -n "${pin_lines[$i]}p" "${pin_files[$i]}")"
    case "$line" in
      *heavy-duty/ceremony/.github/workflows/labels.yml@*)
        if [ -n "$caller" ]; then
          step_refuse \
            "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
            "  Two files call the ceremony labels workflow — $caller and" \
            "  ${pin_files[$i]} — so which one the cron moves off, and which" \
            "  one is granted actions: write, is not a question this step may" \
            "  answer by picking."
        fi
        caller="${pin_files[$i]}"
        caller_pin_line="${pin_lines[$i]}"
        ;;
    esac
  done
  if [ -z "$caller" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  No file under $GITHUB_DIR/ calls the ceremony labels workflow, so" \
      "  there is no caller to move a cron off and none to grant" \
      "  actions: write. This step edits the labels caller and nothing else."
  fi

  # --- the labels caller's `on:` block ---
  IFS=$'\t' read -r on_line on_rest < <(top_level_key "$caller" "on") || true
  if [ -z "${on_line:-}" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller has no top-level 'on:' key, so the schedule and the bare" \
      "  workflow_dispatch this step relocates cannot be found."
  fi
  if [ -n "$on_rest" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller line $on_line writes 'on:' with a value on the same line." \
      "  This step deletes two keys out of that mapping by line, which it can" \
      "  only do when they are lines: a flow list or a flow mapping there has" \
      "  no line of its own to delete."
  fi

  while IFS=$'\t' read -r lineno text; do
    [ -n "$lineno" ] || continue
    case "$text" in
      [[:space:]]*[!\ ]*) ;;
      *) continue ;;
    esac
    indent="${text%%[! ]*}"
    key="$(printf '%s\n' "$text" | yaml_uncomment | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_-]*\):.*$/\1/p')"
    # The block's key indent is the first key's, and only lines at exactly
    # that indent are keys OF the block: a `types:` two levels in belongs to
    # the trigger above it and is none of this step's business.
    [ -n "$key" ] || continue
    [ -n "$on_indent" ] || on_indent="$indent"
    [ "$indent" = "$on_indent" ] || continue
    val="$(printf '%s\n' "$text" | yaml_uncomment | sed "s/^[[:space:]]*$key:[[:space:]]*//")"
    case "$key" in
      schedule)
        sched_count=$((sched_count + 1))
        sched_line="$lineno"
        sched_value="$val"
        ;;
      workflow_dispatch)
        disp_count=$((disp_count + 1))
        disp_line="$lineno"
        [ -z "$val" ] || step_refuse \
          "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
          "  $caller line $lineno writes 'workflow_dispatch:' with a value on" \
          "  the same line. This step deletes the bare key and nothing else."
        ;;
    esac
  done < <(block_body "$caller" "$on_line")

  if [ "$sched_count" -eq 0 ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller declares no 'schedule:' in its 'on:' block, so there is no" \
      "  cron for this step to RELOCATE. The cadence is the consumer's" \
      "  ($GUIDE_NAME says so), and a step that invented one here would be" \
      "  deciding how often a board is swept and what that costs."
  fi
  if [ "$sched_count" -gt 1 ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller declares 'schedule:' $sched_count times in its 'on:' block." \
      "  Which cron moves to the sweep caller is then a guess, and the cost of" \
      "  guessing wrong is a board swept twice a tick or not at all."
  fi
  if [ -z "$sched_value" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller line $sched_line writes 'schedule:' as a block, so the cron" \
      "  it carries runs over lines this step has no anchored way to bound." \
      "  Only a single-line value can be relocated whole."
  fi
  if [ "$disp_count" -gt 1 ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller declares 'workflow_dispatch:' $disp_count times in its 'on:'" \
      "  block, so which one is the bare key this step deletes is a guess."
  fi
  # A dispatch carrying inputs is the consumer's own, and deleting it takes
  # those inputs with it — silently, and only visibly when someone reaches for
  # a dispatch that is no longer there.
  if [ -n "$disp_line" ]; then
    while IFS=$'\t' read -r lineno text; do
      [ -n "$lineno" ] || continue
      [ "$lineno" -gt "$disp_line" ] || continue
      case "$text" in
        [[:space:]]*[!\ ]*) ;;
        *) continue ;;
      esac
      # A comment is not a key and does not close the block: a note written at
      # the block's own indent between `workflow_dispatch:` and its `inputs:`
      # would otherwise end this scan one line short of the thing it looks for.
      case "$(printf '%s\n' "$text" | sed 's/^[[:space:]]*//')" in
        \#*) continue ;;
      esac
      indent="${text%%[! ]*}"
      if [ "${#indent}" -le "${#on_indent}" ]; then break; fi
      step_refuse \
        "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
        "  $caller line $disp_line writes 'workflow_dispatch:' with its own" \
        "  block beneath it (line $lineno). Deleting that key would delete the" \
        "  consumer's own dispatch inputs with it. The sweep caller this step" \
        "  creates declares the inputs $GUIDE_NAME publishes, and it will not" \
        "  quietly discard a different set."
    done < <(block_body "$caller" "$on_line")
  fi

  # --- the labels caller's `permissions:` block ---
  IFS=$'\t' read -r perm_line perm_rest < <(top_level_key "$caller" "permissions") || true
  if [ -z "${perm_line:-}" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller has no top-level 'permissions:' block. Naming any permission" \
      "  sets every unnamed one to none, so this step will not create that" \
      "  block: doing so would decide the caller's whole permission set from" \
      "  one grant."
  fi
  if [ -n "$perm_rest" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller line $perm_line writes 'permissions:' with a value on the" \
      "  same line. This step edits one key of that mapping by line, which it" \
      "  can only do when the keys are lines."
  fi
  while IFS=$'\t' read -r lineno text; do
    [ -n "$lineno" ] || continue
    key="$(printf '%s\n' "$text" | yaml_uncomment | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_-]*\):.*$/\1/p')"
    [ -n "$key" ] || continue
    indent="${text%%[! ]*}"
    [ -n "$perm_indent" ] || perm_indent="$indent"
    [ "$indent" = "$perm_indent" ] || continue
    perm_last_key="$lineno"
    if [ "$key" = "actions" ]; then
      actions_count=$((actions_count + 1))
      actions_line="$lineno"
      actions_value="$(printf '%s\n' "$text" | yaml_uncomment | sed "s/^[[:space:]]*$key:[[:space:]]*//")"
    fi
  done < <(block_body "$caller" "$perm_line")
  if [ -z "$perm_last_key" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller's 'permissions:' block at line $perm_line carries no key" \
      "  this step can read, so it has nowhere anchored to grant" \
      "  actions: write."
  fi
  # THE GRANT HAS EXACTLY TWO ANCHORED SHAPES and no third (codex-bot §2). The
  # guide's edit is "grant actions: write", which on a caller that already
  # reads `actions: read` is a rewrite of that line and on one with no
  # `actions:` key at all — cast's shape — is an insertion. A step that
  # substituted whatever value it found would rewrite a grant it did not put
  # there without saying so, and a step that took the LAST of several
  # `actions:` keys would leave the others behind, so both are refusals: the
  # value is READ here, not just the line number.
  if [ "$actions_count" -gt 1 ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller's 'permissions:' block declares 'actions:' $actions_count" \
      "  times. Which one GitHub reads is not a question this step may answer" \
      "  by rewriting one of them and leaving the rest."
  fi
  if [ "$actions_count" -eq 1 ] && [ "$actions_value" != "read" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller line $actions_line already grants 'actions: $actions_value'." \
      "  This step rewrites an 'actions: read' grant, or inserts the key where" \
      "  the block has none. It does not overwrite a grant someone else chose" \
      "  — including a write already granted by hand, which is that hand's" \
      "  decision to keep and this step's to leave alone."
  fi

  # --- the labels caller's name, and its `with:` block ---
  #
  # The sweep exports the PR-facing caller's name as SELF_WORKFLOW so the
  # label machinery's own check entries never count toward a red-CI blocker.
  # The stub's own comment says to pass it; a caller not named `labels` that
  # does not gets a board whose blockers fire on the board's own workflow.
  #
  # THE NAME IS A YAML SCALAR, so it is decoded here and re-encoded where it
  # is written (codex-bot §3). `name: "labels: private"` is a valid workflow
  # name, and so is one carrying a comma, a brace or a quote; carrying the raw
  # bytes into a flow mapping ships the consumer a `with:` that GitHub cannot
  # parse. One shape is a refusal instead: a double-quoted name carrying a
  # backslash, whose escapes this step would have to implement YAML's
  # double-quoted style to read, and it will not guess at a workflow's name.
  IFS=$'\t' read -r _ caller_name_raw < <(top_level_key "$caller" "name") || true
  caller_name_raw="${caller_name_raw:-}"
  case "$caller_name_raw" in
    '"'*'"')
      case "$caller_name_raw" in
        *\\*)
          step_refuse \
            "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
            "  $caller writes its 'name:' as a double-quoted scalar carrying a" \
            "  backslash escape: $caller_name_raw" \
            "  The sweep caller has to be told what the PR-facing caller is" \
            "  called, and this step will not guess at the name those escapes" \
            "  stand for."
          ;;
      esac
      caller_name="${caller_name_raw#\"}"
      caller_name="${caller_name%\"}"
      ;;
    "'"*"'")
      caller_name="${caller_name_raw#\'}"
      caller_name="${caller_name%\'}"
      # YAML's single-quoted style escapes a quote by doubling it.
      caller_name="${caller_name//\'\'/\'}"
      ;;
    *) caller_name="$caller_name_raw" ;;
  esac
  if [ -z "$caller_name" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller declares no top-level 'name:', so GitHub names that workflow" \
      "  after its path and this step cannot tell the sweep caller what the" \
      "  PR-facing caller is called."
  fi

  # `with:` on the labels caller's job: the routing the new caller inherits.
  # Read at the pin line's own indent, so a `with:` belonging to some other
  # job in the same file is not read as this one's.
  #
  # EVERY key of that job is looked at, not just the ones after the pin. A
  # job is a YAML mapping and its keys are unordered: `secrets: inherit`
  # between the `uses:` and the `with:` is ordinary, and so is a `with:`
  # written ABOVE the `uses:` — a scan starting at the pin line reads neither,
  # carries no routing, reports none to carry, and skips the sweep_workflow
  # guard on the way past (claude-bot §1). So the window is the JOB: found by
  # walking up from the pin to the nearest enclosing key at a lower indent,
  # and read from there to the end of that job's block. Silently carrying
  # nothing is the one way this step is not allowed to be wrong.
  indent="$(sed -n "${caller_pin_line}p" "$caller")"
  indent="${indent%%[! ]*}"
  job_line="$(awk -v pin="$caller_pin_line" -v ind="${#indent}" '
    NR >= pin { exit }
    { line = $0; sub(/[ \t]+$/, "", line) }
    line == "" { next }
    { bare = line; sub(/^[ \t]*/, "", bare) }
    bare ~ /^#/ { next }
    { n = match(line, /[^ ]/) - 1; if (n < ind) last = NR }
    END { if (last) print last }
  ' "$caller")"
  if [ -z "$job_line" ]; then
    step_refuse \
      "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
      "  $caller line $caller_pin_line calls the ceremony labels workflow" \
      "  with nothing enclosing it that this step can read as the job it" \
      "  belongs to, so the routing that job declares cannot be bounded and" \
      "  cannot be carried onto the sweep caller."
  fi
  while IFS=$'\t' read -r lineno text; do
    [ -n "$lineno" ] || continue
    case "$text" in
      "$indent"[!\ ]*) ;;
      *) continue ;;
    esac
    key="$(printf '%s\n' "$text" | yaml_uncomment | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_-]*\):.*$/\1/p')"
    if [ "$key" = "with" ]; then
      with_line="$lineno"
      with_pairs="$(printf '%s\n' "$text" | yaml_uncomment | sed "s/^[[:space:]]*with:[[:space:]]*//")"
    fi
  done < <(awk -v start="$job_line" -v ind="${#indent}" '
    NR <= start { next }
    { line = $0; sub(/[ \t]*$/, "", line) }
    line == "" { next }
    { n = match(line, /[^ ]/) - 1; if (n < ind) exit; printf "%s\t%s\n", NR, $0 }
  ' "$caller")

  if [ -n "$with_line" ]; then
    if [ -z "$with_pairs" ]; then
      step_refuse \
        "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
        "  $caller line $with_line writes 'with:' as a block. This step reads" \
        "  the caller's routing to carry it onto the sweep caller, and it" \
        "  reads only the single-line flow mapping $GUIDE_NAME publishes."
    fi
    case "$with_pairs" in
      "{"*"}") ;;
      *)
        step_refuse \
          "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
          "  $caller line $with_line writes a 'with:' value this step cannot" \
          "  read: $with_pairs" \
          "  It reads only the single-line flow mapping $GUIDE_NAME" \
          "  publishes, and it will not carry routing it has not understood."
        ;;
    esac
    while IFS=$'\t' read -r key val; do
      case "$key" in
        runner) runner="$val" ;;
        sweep_workflow)
          [ "$val" = "labels-sweep.yml" ] || step_refuse \
            "  THE APPLIED STEP FOR $first_crossed CANNOT RUN ON THIS TREE" \
            "  $caller line $with_line already routes the trigger job at a" \
            "  sweep caller named $val, and this step creates" \
            "  $sweep. Renaming a consumer's caller is not this step's to do."
          ;;
      esac
    done < <(printf '%s\n' "$with_pairs" | flow_pairs)
  fi

  # --- the sweep caller's bytes, from the guide at the crossed tag ---
  load_guide "$first_crossed"
  # The anchor is a regex against the guide's own prose, so it is a literal:
  # nothing in it expands, and the backtick is the guide's markup.
  # shellcheck disable=SC2016
  stub_body="$(fenced_block "$guide_file" '^And the complete sweep caller, `labels-sweep\.yml` beside it')"
  # The name the block must open with is DERIVED from the path this step
  # creates, never written out beside it: a workflow's name and its filename
  # are one fact, and the criterion that keeps the stub single-sourced greps
  # for that name declaration and expects to find none under bin/.
  sweep_name="${sweep##*/}"
  sweep_name="${sweep_name%.yml}"
  case "$stub_body" in
    "name: $sweep_name"*) ;;
    *)
      die "$SELF: $GUIDE_NAME at $first_crossed carries no sweep-caller stub" \
        "  this step can read." \
        "" \
        "  It looks for the fenced yaml block published under \"And the" \
        "  complete sweep caller\", and that block must open by naming the" \
        "  workflow $sweep_name. There is no embedded copy of it to fall back" \
        "  to and this step will not write one it did not read. Nothing was" \
        "  written."
      ;;
  esac
  # OCCURRENCES, not lines: `grep -c` counts matching lines, so a stub line
  # carrying the placeholder twice would satisfy a line count and then ship
  # one of the two unsubstituted. A latch for whoever next edits the published
  # block, which is why the substitution below is global as well (claude-bot).
  [ "$(printf '%s\n' "$stub_body" | grep -oF '@<pinned-tag>' | wc -l)" -eq 1 ] || die \
    "$SELF: the sweep-caller stub in $GUIDE_NAME at $first_crossed does not" \
    "  carry exactly one '@<pinned-tag>' placeholder, so this step cannot" \
    "  tell which ref it is being asked to pin. Nothing was written."
  stub_sched_lines="$(printf '%s\n' "$stub_body" | grep -cE '^  schedule:')"
  [ "$stub_sched_lines" -eq 1 ] || die \
    "$SELF: the sweep-caller stub in $GUIDE_NAME at $first_crossed carries" \
    "  $stub_sched_lines 'schedule:' keys, and this step relocates the" \
    "  consumer's cron onto exactly one. Nothing was written."

  # The pin, the consumer's own cadence, and the routing it owns. The cron is
  # RELOCATED and not re-decided: the cadence is the consumer's, and this step
  # moves a schedule rather than choosing one.
  # The cadence is a consumer's own bytes going into a `sed` REPLACEMENT, where
  # `&`, `\` and the delimiter mean something other than themselves. No
  # plausible cron carries one and a block scalar has already been refused
  # above, but the value is not this step's to reason about (claude-bot).
  sched_repl="$(printf '%s' "$sched_value" | sed -e 's/[\\&|]/\\&/g')"
  step_new_body="$(
    printf '%s\n' "$stub_body" |
      sed -e "s|@<pinned-tag>|@$first_crossed|g" \
        -e "s|^  schedule:.*\$|  schedule: $sched_repl|"
  )"
  with_pairs=""
  [ "$caller_name" = "labels" ] ||
    with_pairs="pr_workflow_name: $(flow_scalar "$caller_name")"
  if [ -n "$runner" ]; then
    with_pairs="${with_pairs:+$with_pairs, }runner: $runner"
  fi
  if [ -n "$with_pairs" ]; then
    step_new_body="$step_new_body
    with: { $with_pairs }"
  fi

  step_new_file="$sweep"
  step_edit_file="$caller"
  # EVERY enumerated pin line in this file is masked, not just the labels one
  # (claude-bot §2). The ref pass rewrites all of them, so a walker told about
  # one sees the others as changes the plan never named — a correct rollback,
  # but announced as a bug in this command and a request to report it, for a
  # tree a consumer is entitled to have. The suite's own fixture puts two
  # ceremony pins in one file, so this is an ordinary shape.
  step_edit_ops=()
  for i in "${!pin_files[@]}"; do
    [ "${pin_files[$i]}" = "$caller" ] || continue
    step_edit_ops+=("${pin_lines[$i]}	mask	")
  done
  step_edit_ops+=("$sched_line	del	")
  [ -z "$disp_line" ] || step_edit_ops+=("$disp_line	del	")
  if [ -n "$actions_line" ]; then
    step_edit_ops+=("$actions_line	sub	${perm_indent}actions: write   # the trigger job's dispatch of the sweep caller")
  else
    step_edit_ops+=("$perm_last_key	ins	${perm_indent}actions: write   # the trigger job's dispatch of the sweep caller")
  fi

  step_plan+=(
    "    create $step_new_file — the sweep caller stub $GUIDE_NAME publishes at $first_crossed, with:"
    "      the pin substituted: @$first_crossed"
    "      the cron RELOCATED from $caller line $sched_line, cadence unchanged: $sched_value"
  )
  [ -z "$with_pairs" ] || step_plan+=("      the routing this tree already declares: with: { $with_pairs }")
  step_plan+=("    edit $caller:")
  step_plan+=("      delete line $sched_line — the schedule: key, which MOVES to the sweep caller")
  [ -z "$disp_line" ] || step_plan+=("      delete line $disp_line — the bare workflow_dispatch: key, which the sweep caller declares")
  # THE PLAN SHOWS THE BYTES, not a description of them. This rewrite replaces
  # the line's trailing comment as well as its value — the comment beside a
  # read grant explains a read, and leaving it beside a write is a note that
  # has quietly become false — so a reader who is only told "the actions grant
  # is rewritten" cannot tell before the run whether their own prose survives.
  if [ -n "$actions_line" ]; then
    step_plan+=(
      "      rewrite line $actions_line — actions: write, the trigger job's dispatch being a write:"
      "        - $(sed -n "${actions_line}p" "$caller")"
      "        + ${step_edit_ops[-1]#*$'\t'*$'\t'}"
    )
  else
    step_plan+=(
      "      insert after line $perm_last_key — actions: write, the trigger job's dispatch being a write:"
      "        + ${step_edit_ops[-1]#*$'\t'*$'\t'}"
    )
  fi
}

# flow_scalar VALUE — VALUE encoded so it can be written INSIDE a single-line
# YAML flow mapping and read back as itself (#597, codex-bot §3).
#
# A workflow name is a scalar a consumer chose, and `name: "labels: private"`
# is as valid as `name: labels`. Written raw into `with: { pr_workflow_name:
# ... }` the colon opens a nested mapping, a comma opens a second pair, a
# brace closes the mapping early and a ` #` truncates the line — so what a
# consumer gets is not a differently-routed sweep caller but an unparseable
# one. Plain where plain is safe, so the ordinary name is written the ordinary
# way; single-quoted otherwise, which is YAML's one style with no escapes
# except the doubled quote and therefore the one that cannot be got wrong.
flow_scalar() {
  local v="$1"
  case "$v" in
    *[!A-Za-z0-9\ ._-]*) ;;
    [!A-Za-z0-9]* | *' ') ;;
    "") ;;
    *) printf '%s\n' "$v"; return 0 ;;
  esac
  printf "'%s'\n" "${v//\'/\'\'}"
}

# flow_pairs — a single-line YAML flow mapping on stdin, one "<key>\t<value>"
# per entry. Quote- and bracket-aware, because a routing value is itself a
# quoted JSON list: splitting `{ runner: '["a","b"]' }` on commas is how a
# reader ends up carrying half of one.
flow_pairs() {
  awk '
    BEGIN { sq = sprintf("%c", 39); dq = sprintf("%c", 34) }
    {
      s = $0
      sub(/^[ \t]*\{/, "", s)
      sub(/\}[ \t]*$/, "", s)
      q = ""; depth = 0; cur = ""; n = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; cur = cur c; continue }
        if (c == sq || c == dq) { q = c; cur = cur c; continue }
        if (c == "[" || c == "{") depth++
        if (c == "]" || c == "}") depth--
        if (c == "," && depth == 0) { part[++n] = cur; cur = ""; continue }
        cur = cur c
      }
      if (cur ~ /[^ \t]/) part[++n] = cur
      for (i = 1; i <= n; i++) {
        p = part[i]
        j = index(p, ":")
        if (j == 0) continue
        k = substr(p, 1, j - 1); v = substr(p, j + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", k)
        gsub(/^[ \t]+|[ \t]+$/, "", v)
        printf "%s\t%s\n", k, v
      }
    }
  '
}

step_active=0
requested_target="$target"
if [ "${#crossed[@]}" -gt 0 ]; then
  first_crossed="${ladder[$first_crossed_i]}"
  # THE DISPATCH. An unmechanised first crossed tag refuses and stops here;
  # everything below this line belongs to a tag that has an applied step.
  [ -n "$first_crossed_step" ] || refuse_crossing
  step_active=1
  # THE MOVE IS RE-AIMED AT THE FIRST CROSSED TAG, and everything downstream —
  # the ref rewrite, the verification, the mirror — runs against that tag and
  # not against the one that was asked for.
  requested_target_i="$target_i"
  target="$first_crossed"
  target_i="$first_crossed_i"
  for ((i = first_crossed_i + 1; i <= requested_target_i; i++)); do
    for row in "${MIGRATIONS[@]}"; do
      if [ "${row%%|*}" = "${ladder[$i]}" ]; then
        step_next_crossed="${ladder[$i]}"
        break 2
      fi
    done
  done
  "$first_crossed_step"
fi

# --- the plan, and (only in --fix) the writes ------------------------------

if [ "$step_active" -eq 1 ]; then
  echo "$SELF: $current -> $requested_target crosses ${#crossed[@]} migration(s); $first_crossed is an APPLIED STEP, so this run performs $current -> $first_crossed and stops there."
  echo "$SELF: $current -> $target, ${#pin_files[@]} ceremony ref(s) in ${#pin_file_list[@]} file(s) under $GITHUB_DIR/:"
  ref_report
  echo "$SELF: THE PLAN"
  echo "    rewrite ${#pin_files[@]} ceremony ref(s) from @$current to @$target"
  printf '%s\n' "${step_plan[@]}"
  echo "    then re-sync the doctrine mirror (docs-sync --fix)."
else
  echo "$SELF: $current -> $target, ${#pin_files[@]} ceremony ref(s) in ${#pin_file_list[@]} file(s) under $GITHUB_DIR/:"
  ref_report
  echo "$SELF: no migration between $current and $target (checked ${#MIGRATIONS[@]} table entries against the ${#ladder[@]}-tag ladder at $ladder_origin)."
fi

# report_remainder — what this run did NOT do, and how the rest is reached.
# An applied step stops at the first crossed tag, so the operator is told the
# pin this run leaves behind and what still stands between it and the tag they
# asked for. Non-zero when the requested move did not complete: a run that
# performed one rung of a longer move has not done what it was asked, and
# saying so with an exit code is the difference between a ladder and a silent
# short move.
report_remainder() {
  [ "$step_active" -eq 1 ] || return 0
  echo "$SELF: THIS RUN LEAVES THE PIN AT $first_crossed."
  if [ "$first_crossed" = "$requested_target" ]; then
    return 0
  fi
  echo "$SELF: REMAINING: $first_crossed -> $requested_target is not performed by this run."
  if [ -n "$step_next_crossed" ]; then
    echo "$SELF: The next migration between them is $step_next_crossed. Commit what this run produced, then run this command again from the new pin."
  else
    echo "$SELF: No migration stands between them. Commit what this run produced, then run this command again from the new pin."
  fi
  return 1
}

if [ "$mode" = "check" ]; then
  if [ "$step_active" -eq 1 ]; then
    echo "$SELF: --check changes nothing. Re-run with --fix to perform the step above."
    report_remainder || exit 1
    exit 0
  fi
  echo "$SELF: --check changes nothing. Re-run with --fix to rewrite the ref(s) and re-sync the mirror (docs-sync --fix)."
  exit 0
fi

# THE WRITES ARE THE PLAN, LINE FOR LINE. awk is aimed at the line NUMBERS
# enumerate_pins reported and looks at no other line in the file, so "the
# rewrite is anchored to the `uses:` shape and touches nothing else" is true
# by construction rather than by a second pattern agreeing with the first.
# On those lines it replaces the FIRST '@' token — which is the ref, the path
# having been forbidden to contain '@'.
#
# The file is rewritten through a temporary and copied back with `cat >`, so
# it keeps its mode and its inode: the alternative is `sed -i`, whose in-place
# semantics differ between GNU and BSD and whose expression, applied to a
# whole workflow file, is the tool this command exists to replace.
#
# A FILE THAT ENDED WITHOUT A NEWLINE STILL DOES. awk's `print` terminates
# every record, so the last line of such a file came back one byte longer —
# a byte outside the `uses:` line, which #561 G8 says this command never
# touches (claude-bot, round 1). The byte is removed again below.
#
# The list is pin_file_list, the distinct files enumerate_pins found, so a
# file carrying two pins is visited once. The previous shape kept a per-file
# stamp keyed by `tr '/' '_'`, which is not injective — `a/b.yml` and
# `a_b.yml` shared a stamp, the second was skipped, and the run still said
# `done` at exit 0 (claude-bot, round 1). A key that cannot collide beats a
# key that collides less: there is no key.
take_snapshot

planned_refs="${#pin_files[@]}"
planned_files="${#pin_file_list[@]}"
expected_refs="$planned_refs"
expected_files="$planned_files"

rewritten=0
for f in "${pin_file_list[@]}"; do
  final_nl=1
  if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l)" -eq 0 ]; then
    final_nl=0
  fi
  awk -v new="$target" -v want="$(pin_lines_in "$f")" '
    BEGIN { n = split(want, a, ","); for (i = 1; i <= n; i++) target_line[a[i]] = 1 }
    (NR in target_line) { sub(/@[^ \t#]+/, "@" new) }
    { print }
  ' "$f" >"$scratch/rewritten"
  if [ "$final_nl" -eq 0 ]; then
    size="$(wc -c <"$scratch/rewritten")"
    if [ "$size" -gt 0 ]; then
      head -c "$((size - 1))" "$scratch/rewritten" >"$scratch/trimmed"
      mv "$scratch/trimmed" "$scratch/rewritten"
    fi
  fi
  cat "$scratch/rewritten" >"$f"
  rewritten=$((rewritten + 1))
done

# --- the applied step's own writes ----------------------------------------
#
# AFTER the refs and never before: the ops the step planned are keyed by line
# number in the file as `enumerate_pins` read it, and the ref rewrite above
# substitutes inside a line without adding or removing one, so those numbers
# still point where the step aimed them. The step's own deletions DO move
# lines, which is why they happen second and why nothing keyed by line number
# runs after them.
#
# One writer, and it is here rather than in the step: the step declared what
# to do and this is the only code that does it, so a step cannot write outside
# the plan, outside the snapshot, or past the verification below.
if [ "$step_active" -eq 1 ] && [ -n "$step_edit_file" ]; then
  printf '%s\n' "${step_edit_ops[@]}" >"$scratch/edit-ops"
  final_nl=1
  if [ -s "$step_edit_file" ] && [ "$(tail -c 1 "$step_edit_file" | wc -l)" -eq 0 ]; then
    final_nl=0
  fi
  awk -v ops="$scratch/edit-ops" '
    BEGIN {
      FS = "\t"
      while ((getline l < ops) > 0) {
        split(l, f, "\t")
        kind[f[1] + 0] = f[2]
        text[f[1] + 0] = f[3]
      }
    }
    {
      if (NR in kind) {
        if (kind[NR] == "del") next
        if (kind[NR] == "sub") { print text[NR]; next }
        if (kind[NR] == "ins") { print; print text[NR]; next }
      }
      print
    }
  ' "$step_edit_file" >"$scratch/edited"
  if [ "$final_nl" -eq 0 ]; then
    size="$(wc -c <"$scratch/edited")"
    if [ "$size" -gt 0 ]; then
      head -c "$((size - 1))" "$scratch/edited" >"$scratch/trimmed"
      mv "$scratch/trimmed" "$scratch/edited"
    fi
  fi
  cat "$scratch/edited" >"$step_edit_file"
fi
if [ "$step_active" -eq 1 ] && [ -n "$step_new_file" ]; then
  [ ! -e "$step_new_file" ] || die \
    "$SELF: $step_new_file appeared between the plan and the write." \
    "  Nothing further will be written; the tree is rolled back."
  mkdir -p "$(dirname "$step_new_file")"
  printf '%s\n' "$step_new_body" >"$step_new_file"
  # The file the step creates carries a ceremony pin of its own, so what the
  # re-enumeration expects has to grow with it or that pin reads as a ref
  # nobody announced. The REWRITE's own counts do not grow: this file was
  # created at the target and never rewritten, and a message conflating the
  # two tells the operator a file was edited that was not there to edit.
  expected_refs=$((expected_refs + 1))
  expected_files=$((expected_files + 1))
fi

# --- the rewrite verifies its own work ------------------------------------
#
# THE WRITES WERE NEVER CHECKED AGAINST THE PLAN, and that — not any one
# regex — is what let both of round 1's rewrite defects ship silently
# (claude-bot §3). Two assertions, and between them they say the whole of
# what was announced:
#
#   1. Re-enumerate with PIN_RE, the same reader that produced the plan: the
#      counts must be the counts printed above and every ref must now be
#      @$target. A file skipped by a colliding key fails here loudly instead
#      of passing as `done`.
#   2. Outside the enumerated lines, every rewritten file must be byte-
#      identical to its snapshot — compared with those lines masked out, plus
#      the final-newline byte checked directly, since masking normalises it.
#      A rewrite that reached a line the plan never named fails here, whatever
#      made it reach.
#
# Either failure rolls the whole tree back through the EXIT trap.
mask_pin_lines() {
  awk -v want="$2" '
    BEGIN { n = split(want, a, ","); for (i = 1; i <= n; i++) target_line[a[i]] = 1 }
    (NR in target_line) { print "ceremony-upgrade:masked-pin-line"; next }
    { print }
  ' "$1"
}
has_final_newline() {
  if [ ! -s "$1" ]; then
    printf 'yes\n'
  elif [ "$(tail -c 1 "$1" | wc -l)" -eq 0 ]; then
    printf 'no\n'
  else
    printf 'yes\n'
  fi
}

# walk_edit_ops BEFORE AFTER OPS — the same assertion for a file an applied
# step edited, where masking cannot serve: a deletion moves every line after
# it, so there is no line number that means the same thing on both sides.
#
# It is a COMPARISON and never a second application of the ops, which is the
# whole point: rebuilding the expected file with the code that wrote it would
# agree with itself no matter what that code did. This walks the snapshot and
# the result together, following the plan — a `del` consumes a before line and
# no after line, an `ins` consumes one of each and then requires the announced
# line, a `sub` requires the announced line in place of the before one, a
# `mask` is the ref rewrite's own line and is compared by the pin assertions
# instead, and every other line must survive byte for byte. It ends only when
# both sides end together, so a line the plan never mentioned cannot be added
# at the tail either.
walk_edit_ops() {
  awk -v ops="$3" -v before="$1" -v after="$2" '
    BEGIN {
      while ((getline l < ops) > 0) {
        split(l, f, "\t")
        kind[f[1] + 0] = f[2]
        text[f[1] + 0] = f[3]
      }
      na = 0; nb = 0
      while ((getline l < after) > 0) a[++na] = l
      while ((getline l < before) > 0) b[++nb] = l
      ai = 1
      for (bi = 1; bi <= nb; bi++) {
        k = (bi in kind) ? kind[bi] : "keep"
        if (k == "del") continue
        if (ai > na) { print "the result ends at line " ai - 1 ", before the plan does"; exit }
        if (k == "mask") { ai++; continue }
        if (k == "sub") {
          if (a[ai] != text[bi]) { print "line " bi " was rewritten to something the plan did not announce"; exit }
          ai++
          continue
        }
        if (a[ai] != b[bi]) { print "line " bi " changed and the plan never named it"; exit }
        ai++
        if (k == "ins") {
          if (ai > na) { print "the line the plan inserts after line " bi " is not there"; exit }
          if (a[ai] != text[bi]) { print "the line inserted after line " bi " is not the one the plan announced"; exit }
          ai++
        }
      }
      if (ai != na + 1) { print "the result carries " na - ai + 1 " line(s) past the end of the plan" }
    }
  ' </dev/null
}

verify_failures=()
for f in "${pin_file_list[@]}"; do
  if [ "$step_active" -eq 1 ] && [ "$f" = "$step_edit_file" ]; then
    continue
  fi
  want="$(pin_lines_in "$f")"
  mask_pin_lines "$SNAP/$f" "$want" >"$scratch/masked-before"
  mask_pin_lines "$f" "$want" >"$scratch/masked-after"
  if ! cmp -s "$scratch/masked-before" "$scratch/masked-after"; then
    verify_failures+=("$f changed outside the ${want:-none} line(s) the plan named")
  fi
  if [ "$(has_final_newline "$SNAP/$f")" != "$(has_final_newline "$f")" ]; then
    verify_failures+=("$f's final newline changed, and that byte is not part of any pin line")
  fi
done

if [ "$step_active" -eq 1 ] && [ -n "$step_edit_file" ]; then
  walked="$(walk_edit_ops "$SNAP/$step_edit_file" "$step_edit_file" "$scratch/edit-ops")"
  [ -z "$walked" ] || verify_failures+=("$step_edit_file: $walked")
  if [ "$(has_final_newline "$SNAP/$step_edit_file")" != "$(has_final_newline "$step_edit_file")" ]; then
    verify_failures+=("$step_edit_file's final newline changed, and that byte is in no line the plan named")
  fi
fi
if [ "$step_active" -eq 1 ] && [ -n "$step_new_file" ]; then
  if [ ! -f "$step_new_file" ]; then
    verify_failures+=("the plan creates $step_new_file and it is not there")
  else
    printf '%s\n' "$step_new_body" >"$scratch/planned-new"
    cmp -s "$scratch/planned-new" "$step_new_file" ||
      verify_failures+=("$step_new_file is not the bytes the plan announced")
  fi
fi

enumerate_pins
if [ "${#pin_files[@]}" -ne "$expected_refs" ]; then
  verify_failures+=("the plan named $expected_refs ceremony ref(s); the tree now carries ${#pin_files[@]}")
fi
if [ "${#pin_file_list[@]}" -ne "$expected_files" ]; then
  verify_failures+=("the plan named $expected_files file(s) carrying a pin; the tree now has ${#pin_file_list[@]}")
fi
for i in "${!pin_refs[@]}"; do
  if [ "${pin_refs[$i]}" != "$target" ]; then
    verify_failures+=("${pin_files[$i]} line ${pin_lines[$i]} is still at @${pin_refs[$i]}, not @$target")
  fi
done

if [ "${#verify_failures[@]}" -gt 0 ]; then
  {
    echo "$SELF: FAULT — the rewrite did not do what the plan said, so it is being undone."
    echo
    printf '    %s\n' "${verify_failures[@]}"
    echo
    echo "  This is a bug in $SELF, not something a consumer tree can cause and"
    echo "  not something to work around by hand: --check announced a plan and"
    echo "  --fix produced something else, which is the one thing this command"
    echo "  must never do quietly. Please report it against heavy-duty/ceremony"
    echo "  with the output above."
  } >&2
  exit 1
fi
echo "$SELF: rewrote $planned_refs ceremony ref(s) in $rewritten file(s) to @$target, and verified the tree against the plan."
if [ "$step_active" -eq 1 ] && [ -n "$step_new_file" ]; then
  echo "$SELF: created $step_new_file at @$target, and verified it against the bytes the plan announced."
fi

# The pin this reads is the one just written, which is why the call is here
# and not before the rewrite. It is inside the transaction: docs-sync refuses
# mid-write on a broken scaffold marker, and until this was snapshotted that
# refusal left the consumer pinned forward with a half-written mirror
# (codex-bot, round 1).
echo "$SELF: re-syncing the doctrine mirror (docs-sync --fix)."
if [ -n "$source_dir" ]; then
  bash "$DOCS_SYNC" --fix --source "$source_dir"
else
  bash "$DOCS_SYNC" --fix
fi

# Past every way this run could still fail: from here the tree keeps what was
# written to it.
committed=1
if [ "$step_active" -eq 1 ]; then
  echo "$SELF: $current -> $target done, including the applied step for $first_crossed. Commit the ref(s), the caller files and the mirror together: a pin that moves without the edits that tag requires is the half-upgraded tree this command refuses everywhere else."
  report_remainder || exit 1
  exit 0
fi
echo "$SELF: $current -> $target done. Commit the ref(s) and the mirror together: the pin and the doctrine it governs are one change."
